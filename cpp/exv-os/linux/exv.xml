<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="video/x-exv">
    <comment>EXV HDR Still/Video Container</comment>
    <magic priority="80">
      <match value="EXV1" type="string" offset="0"/>
    </magic>
    <glob pattern="*.exv"/>
    <glob pattern="*.exs"/>
  </mime-type>
</mime-info>
